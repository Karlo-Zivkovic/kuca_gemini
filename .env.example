# Public URL of the site (used for SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://villagemini.example

# Neon Postgres (set automatically by the Vercel ↔ Neon integration).
# Leave empty locally to use .data/dev-db.json instead.
DATABASE_URL=

# Admin app (/admin): mom's password + a random 32+ char secret for the login cookie
# Generate the secret with: openssl rand -base64 48
ADMIN_PASSWORD=
SESSION_SECRET=

# Inquiry emails via Resend (resend.com).
# TO   = mom's inbox, where inquiries land (guest's address is set as Reply-To).
# FROM = sender address; must be on a domain verified in Resend (cannot be @gmail.com).
#        Until the domain exists, use "Villa Gemini <onboarding@resend.dev>", which only
#        delivers to the email the Resend account was registered with.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=fanica.zivkovic@gmail.com
INQUIRY_FROM_EMAIL="Villa Gemini <upiti@villagemini.example>"

# Public contact email shown on the site (defaults to fanica.zivkovic@gmail.com)
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX); empty = analytics off
NEXT_PUBLIC_GA_ID=
